# Kingdom Cloud — Caddy web server with automatic HTTPS for the platform,
# every church subdomain and every custom domain churches connect.
#
# 1. Point DNS for yourplatform.com AND *.yourplatform.com at this server.
# 2. Replace yourplatform.com and the PHP-FPM socket below.
# 3. caddy run --config /etc/caddy/Caddyfile
#
# Custom domains get certificates "on demand": before issuing one, Caddy asks the
# platform whether the domain belongs to a church (ks/v1/tls), so nobody can make
# you request certificates for random domains.

{
	email you@yourplatform.com
	on_demand_tls {
		ask http://127.0.0.1/wp-json/ks/v1/tls
	}
}

(wordpress) {
	root * /var/www/platform
	encode zstd gzip
	php_fastcgi unix//run/php/php8.3-fpm.sock
	file_server
	@blocked path /wp-config.php /xmlrpc.php /wp-content/debug.log
	respond @blocked 404
}

# Platform + church subdomains (wildcard certificate needs a DNS provider plugin,
# or remove the *. line and let on-demand TLS issue one per subdomain).
yourplatform.com, *.yourplatform.com {
	import wordpress
}

# Every other host = a church's custom domain.
https:// {
	tls {
		on_demand
	}
	import wordpress
}

# Internal plain-HTTP listener used by the "ask" check above.
http://127.0.0.1 {
	import wordpress
}
